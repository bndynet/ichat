{
  "name": "@bndynet/ichat-renderers",
  "version": "3.2.0",
  "description": "Lightweight fenced-code renderers for @bndynet/ichat-messages: KPI cards and interactive forms. No heavy third-party dependencies.",
  "keywords": [
    "ai-chat",
    "chat-ui",
    "chatbot-ui",
    "web-components",
    "lit",
    "llm-ui",
    "streaming",
    "markdown",
    "fenced-code",
    "renderer"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@bndynet/ichat-messages": "^3.2.0"
  },
  "devDependencies": {
    "@bndynet/ichat-messages": "file:../chat-messages",
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "homepage": "https://github.com/bndynet/ichat#readme",
  "bugs": {
    "url": "https://github.com/bndynet/ichat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
