{
  "name": "@bndynet/ichat-input",
  "version": "3.1.0",
  "description": "Lit 3 chat input Web Component: auto-resize textarea, send button, streaming cancel, and keyboard shortcuts.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "tsup test/chat-input.test.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-input-tests --clean --silent && node ../../node_modules/.cache/ichat-input-tests/chat-input.test.mjs",
    "test:coverage": "tsup test/chat-input.test.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-input-tests --clean --silent && node --test --experimental-test-coverage ../../node_modules/.cache/ichat-input-tests/chat-input.test.mjs"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "lit": "^3.3.0",
    "sass-embedded": "^1.86.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
