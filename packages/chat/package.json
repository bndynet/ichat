{
  "name": "@bndynet/ichat",
  "version": "2.1.1",
  "description": "Complete Lit 3 chat Web Component: messages + input. Register optional renderers (e.g. @bndynet/ichat-renderers) in your app.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sse": {
      "types": "./dist/sse/index.d.ts",
      "import": "./dist/sse/index.js",
      "require": "./dist/sse/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "tsup test/chat.test.ts --no-config --format esm --platform node --target node18 --loader .scss=text --out-dir ../../node_modules/.cache/ichat-tests --clean --silent && node ../../node_modules/.cache/ichat-tests/chat.test.js"
  },
  "dependencies": {
    "@bndynet/ichat-input": "^2.1.1",
    "@bndynet/ichat-messages": "^2.1.1",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@bndynet/ichat-input": "file:../chat-input",
    "@bndynet/ichat-messages": "file:../chat-messages",
    "sass-embedded": "^1.86.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
