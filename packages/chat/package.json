{
  "name": "@bndynet/ichat",
  "version": "3.1.0",
  "description": "Complete Lit 3 chat Web Component: messages + input. Register optional renderers (e.g. @bndynet/ichat-renderers) in your app.",
  "keywords": [
    "ai-chat",
    "chat-ui",
    "chatbot-ui",
    "chat-component",
    "web-components",
    "custom-elements",
    "lit",
    "llm",
    "llm-ui",
    "streaming",
    "markdown",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tsup --config tsup.global.config.ts",
    "test": "tsup test/*.test.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-tests --clean --silent && node --test ../../node_modules/.cache/ichat-tests/*.mjs",
    "test:browser": "vite --config test/browser/vite.config.ts --host 127.0.0.1 --port 4179 --strictPort",
    "test:browser:build": "vite build --config test/browser/vite.config.ts"
  },
  "dependencies": {
    "@bndynet/ichat-input": "^3.1.0",
    "@bndynet/ichat-messages": "^3.1.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@bndynet/ichat-input": "file:../chat-input",
    "@bndynet/ichat-messages": "file:../chat-messages",
    "lit": "^3.3.0",
    "sass-embedded": "^1.86.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "homepage": "https://github.com/bndynet/ichat#readme",
  "bugs": {
    "url": "https://github.com/bndynet/ichat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
