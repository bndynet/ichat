{
  "name": "@bndynet/ichat-messages",
  "version": "3.1.0",
  "description": "Lit 3 chat message UI as Web Components: Markdown + syntax highlighting, pluggable fenced-block renderers, collapsible reasoning, and streaming previews (bring your own composer).",
  "keywords": [
    "ai-chat",
    "chat-ui",
    "chatbot-ui",
    "chat-messages",
    "web-components",
    "custom-elements",
    "lit",
    "llm-ui",
    "streaming",
    "markdown",
    "syntax-highlighting",
    "reasoning"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "tsup test/*.test.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-messages-tests --clean --silent && node --test ../../node_modules/.cache/ichat-messages-tests/*.mjs",
    "test:coverage": "tsup test/*.test.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-messages-tests --clean --silent && node --test --experimental-test-coverage ../../node_modules/.cache/ichat-messages-tests/*.mjs",
    "benchmark:streaming": "tsup bench/streaming-markdown.bench.ts --config ../../tools/tsup-node-esm.config.ts --out-dir ../../node_modules/.cache/ichat-messages-bench --clean --silent && node ../../node_modules/.cache/ichat-messages-bench/streaming-markdown.bench.mjs",
    "benchmark:streaming:browser": "vite --config bench/browser/vite.config.ts --host 127.0.0.1 --port 4178 --strictPort",
    "benchmark:streaming:browser:build": "vite build --config bench/browser/vite.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "lit": "^3.3.0",
    "markdown-it": "^14.1.0",
    "morphdom": "^2.7.8"
  },
  "peerDependencies": {
    "highlight.js": ">=11"
  },
  "peerDependenciesMeta": {
    "highlight.js": { "optional": true }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/morphdom": "^2.3.0",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.0",
    "sass-embedded": "^1.86.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^6.4.2"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "homepage": "https://github.com/bndynet/ichat#readme",
  "bugs": {
    "url": "https://github.com/bndynet/ichat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
