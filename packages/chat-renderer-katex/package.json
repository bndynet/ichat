{
  "name": "@bndynet/ichat-renderer-katex",
  "version": "3.1.0",
  "description": "KaTeX math rendering plugin for @bndynet/ichat: $inline$ and $$display$$ LaTeX math via markdown-it-katex.",
  "keywords": [
    "ai-chat",
    "chat-ui",
    "chatbot-ui",
    "web-components",
    "lit",
    "llm-ui",
    "markdown",
    "markdown-it-plugin",
    "katex",
    "latex",
    "math",
    "tex"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@bndynet/ichat-messages": "^3.1.0",
    "markdown-it": ">=14"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "markdown-it-katex": "^2.0.3"
  },
  "devDependencies": {
    "@bndynet/ichat-messages": "file:../chat-messages",
    "markdown-it": "^14.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "homepage": "https://github.com/bndynet/ichat#readme",
  "bugs": {
    "url": "https://github.com/bndynet/ichat/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
