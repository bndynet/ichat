{
  "name": "@bndynet/ichat-renderer-mermaid",
  "version": "3.0.0",
  "description": "Mermaid diagram fenced-code renderer for @bndynet/ichat: theme-aware diagrams with async rendering.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@bndynet/ichat-messages": "^3.0.0",
    "markdown-it": ">=14"
  },
  "dependencies": {
    "mermaid": "^11.4.0"
  },
  "devDependencies": {
    "@bndynet/ichat-messages": "file:../chat-messages",
    "@types/markdown-it": "^14.1.2",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bndynet/ichat.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
